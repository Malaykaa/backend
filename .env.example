# ─── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=local                  # local | dev | staging | prod
DEBUG=true

# ─── Database (PostgreSQL + pgvector) ──────────────────────────────────────────
# pgvector requis : utiliser l'image `pgvector/pgvector:pg16` ou installer
# l'extension via `CREATE EXTENSION vector;`.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/malaykaa

# ─── Auth (JWT httpOnly cookies) ───────────────────────────────────────────────
# JWT_SECRET_KEY: 32+ caractères aléatoires en staging/prod (fail-fast au boot)
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ─── LLM (provider unique) ─────────────────────────────────────────────────────
# mock=déterministe (tests), openai|gemini|claude=appel réseau
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ─── Embeddings (Perplexity pplx-embed-v1) ─────────────────────────────────────
# Sans clé : recherche sémantique désactivée → fallback ILIKE sur scraped_offers.
PERPLEXITY_API_KEY=

# ─── Scraping (Apify) ──────────────────────────────────────────────────────────
APIFY_API_TOKEN=
SCRAPING_ENABLED=false             # true = active la pipeline + scheduler

# ─── OTP / WhatsApp ────────────────────────────────────────────────────────────
# OneMessage = provider principal. Twilio = fallback rollback.
# En staging/prod, au moins l'un des deux est obligatoire (fail-fast au boot).
ONEMESSAGE_BASE_URL=
ONEMESSAGE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# DEV ONLY — accepte tout code à 6 chiffres. Refusé en staging/prod.
OTP_MOCK_ACCEPT_ANY=false

# ─── Redis (OTP store + cache) ─────────────────────────────────────────────────
# En staging/prod : obligatoire (fail-fast). En local : fallback mémoire.
REDIS_URL=redis://localhost:6379/0

# ─── Sécurité avancée ──────────────────────────────────────────────────────────
# BLACKLIST_FAIL_CLOSED : comportement si Redis est hors-ligne lors d'un /auth/refresh.
#   false (défaut) : fail-open  — les tokens révoqués restent utilisables jusqu'à expiration (acceptable en dev).
#   true           : fail-closed — /auth/refresh renvoie 401 si Redis est indisponible.
#   ⚠️  Recommandé en production : définir BLACKLIST_FAIL_CLOSED=true dans .env.prod.
BLACKLIST_FAIL_CLOSED=false

# ─── Scheduler (APScheduler in-process) ────────────────────────────────────────
# Déploiement single-process : SCHEDULER_ENABLED=true suffit.
#
# Déploiement multi-worker (Gunicorn + uvicorn workers) — deux options :
#   Option A (explicite) : SCHEDULER_ENABLED=false sur N-1 workers, =true sur 1 seul.
#   Option B (automatique) :
#     - Tous les workers : SCHEDULER_ENABLED=true, SCHEDULER_WORKER_ONLY=true
#     - Worker désigné uniquement : ajouter SCHEDULER_WORKER=true dans son env
#     → Le scheduler ne démarre que sur le worker où les deux flags sont vrais.
#
# Garde-fou supplémentaire (toutes options) : advisory lock pg par job
# (pg_try_advisory_lock). Évite les doublons même si plusieurs schedulers tournent.
SCHEDULER_ENABLED=true
SCHEDULER_WORKER_ONLY=false        # true = n'activer le scheduler que si SCHEDULER_WORKER=true
SCHEDULER_WORKER=false             # true = ce process est le worker désigné pour le scheduler
MATCH_DEFAULT_FREQUENCY_HOURS=6    # cron de matching automatique par défaut
MATCH_TOP_K=5                      # nombre d'offres poussées par run

# ─── Frontend & CORS ───────────────────────────────────────────────────────────
# FRONTEND_URL : URL publique de l'application frontend.
#   Utilisée pour construire les liens dans les notifications WhatsApp.
#   ⚠️  En staging/prod : OBLIGATOIRE — l'app refuse de démarrer si localhost.
#   Local  : http://localhost:5173
#   Prod   : https://app.malayka.com
FRONTEND_URL=http://localhost:5173

# CORS_ORIGINS : liste JSON des origines autorisées à appeler l'API.
#   ⚠️  En staging/prod : remplacer localhost par le domaine réel du frontend.
#       Un warning est émis au boot si localhost reste présent.
#   Local  : ["http://localhost:5173","http://localhost:3000"]
#   Prod   : ["https://app.malayka.com","https://www.malayka.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
