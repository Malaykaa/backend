ENVIRONMENT=local
DEBUG=true

# Base de données — même instance Postgres, base séparée
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/malaykaa_staging

# Auth JWT
JWT_SECRET_KEY=change-me-staging
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# LLM
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Embeddings / Scraping
PERPLEXITY_API_KEY=
APIFY_API_TOKEN=
SCRAPING_ENABLED=false

# OTP
ONEMESSAGE_BASE_URL=
ONEMESSAGE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
OTP_MOCK_ACCEPT_ANY=true

# Redis
REDIS_URL=redis://redis:6379/1

# Scheduler
SCHEDULER_ENABLED=false
BLACKLIST_FAIL_CLOSED=false

# CORS
FRONTEND_URL=https://staging.malayka.co
CORS_ORIGINS=["https://staging.malayka.co"]
